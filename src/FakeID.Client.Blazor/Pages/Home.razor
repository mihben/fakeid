@using FakeID.Api
@using FakeID.Client.Blazor.Dialogs
@using FakeID.Client.Blazor.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using STrain
@using System.Threading.Tasks
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@inject IDialogService DialogService;
@inject IClientDataService dataService;

@page "/"

<PageTitle>Clients</PageTitle>

<div class="content">
    <div class="container clients__container">
        <span class="title">Clients</span>

        <div class="clients__data">
            <div class="clients__header">
                <FluentSearch Placeholder="Search for client" AutoComplete="off"
                              @bind-Value="@_criteria" @bind-Value:after="Search"
                              Immediate="true" ImmediateDelay="100"></FluentSearch>
                @if (_ascending) {
                    <FluentButton IconEnd="new Icons.Regular.Size20.TextSortAscending()" OnClick="@ChangeOrder"></FluentButton>
                }
                else {
                    <FluentButton IconEnd="new Icons.Regular.Size20.TextSortDescending()" OnClick="@ChangeOrder"></FluentButton>
                }
            </div>

            <FluentDataGrid Items="@GetClients()" ShowHover="true" GenerateHeader="GenerateHeaderOption.None">
                <SelectColumn TGridItem="Models.Client" SelectMode="DataGridSelectMode.SingleSticky" Property="c => dataService.Selected?.Id == c.Id"
                              SelectFromEntireRow="true" OnSelect="@(c => dataService.Selected = c.Item)" Width="0px" Style="display: none"></SelectColumn>
                <TemplateColumn>
                    <div class="client__content">
                        <span>@context.Name</span>
                        <FluentButton Class="icon_button" OnClick="@EditClientAsync">
                            <FluentIcon Value="@(new Icons.Regular.Size12.Edit())" />
                        </FluentButton>
                        <FluentButton Class="icon_button icon_button--danger" OnClick="@DeleteAsync">
                            <FluentIcon Value="@(new Icons.Regular.Size12.Delete())"/>
                        </FluentButton>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>

            <FluentButton Appearance="Appearance.Accent" OnClick="@AddNewClientAsync">Add New Client</FluentButton>
        </div>
    </div>
    <div class="container">
    </div>
</div>


@code {
    private bool _ascending = true;

    private string? _criteria = null;

    private IEnumerable<Models.Client> _filteredClients = Enumerable.Empty<Models.Client>();

    private Models.Client? _client = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await dataService.LoadAsync(CancellationToken.None);
            _filteredClients = dataService.Clients;
            StateHasChanged();
        }
        base.OnAfterRender(firstRender);

    }

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(_criteria)) _filteredClients = dataService.Clients;
        else _filteredClients = dataService.Clients.Where(c => c.Name is not null && c.Name.ToLowerInvariant().StartsWith(_criteria.ToLowerInvariant()));

        dataService.Selected = _filteredClients.FirstOrDefault();
    }

    private async Task AddNewClientAsync()
    {
        var dialog = await DialogService.ShowDialogAsync<EditClientDialog>(new Models.Client() { Id = Guid.NewGuid() }, new DialogParameters
        {
            PreventDismissOnOverlayClick = true
        });

        var result = await dialog.Result;
        if (result.Cancelled) return;

        var data = (Models.Client)result.Data!;

        await dataService.SaveAsync(data, CancellationToken.None);
        Search();
    }

    private async Task EditClientAsync()
    {
        if (dataService.Selected is null) return;

        var dialog = await DialogService.ShowDialogAsync<EditClientDialog>(dataService.Selected, new DialogParameters
        {
            PreventDismissOnOverlayClick = true
        });

        var result = await dialog.Result;
        if (result.Cancelled) return;

        var data = (Models.Client)result.Data!;

        await dataService.SaveAsync(data, CancellationToken.None);
        Search();
    }

    private async Task DeleteAsync()
    {
        await dataService.DeleteAsync(CancellationToken.None);
        Search();
    }

    private void ChangeOrder()
    {
        _ascending = !_ascending;
    }

    private IQueryable<Models.Client> GetClients()
    {
        if (_ascending) return _filteredClients.OrderBy(c => c.Name).AsQueryable();
        else return _filteredClients.OrderByDescending(c => c.Name).AsQueryable();
    }
}
