@using FakeID.Api
<BxPanel Collapsable="false" ShowHeader="false">
    <div class="content" @onclick="SelectAsync">
        <div class="main-data">
            <span class="name">@Persona.FirstName, @Persona.LastName</span>
            <span>(@Persona.Role)</span>
        </div>
        <span>@Persona.Email</span>
    </div>
</BxPanel>

@code {
    [Parameter, EditorRequired]
    public GetPersonasByClientQuery.Result Persona { get; set; }

    [Parameter]
    public EventCallback<GetPersonasByClientQuery.Result> Selected { get; set; }

    public async Task SelectAsync()
    {
        await Selected.InvokeAsync(Persona);
    }
}
